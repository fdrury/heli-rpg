# Godot
.godot/
game/.godot/
*.translation
export_presets.cfg

# .NET
bin/
obj/
*.user
.vs/

# Tools (engine binaries are large; not vendored)
tools/godot/
tools/models/
tools/whisper/

# Builds
builds/
*.pck
*.exe.zip

# Assets staging (raw downloads before processing)
assets_raw/

# OS
Thumbs.db
desktop.ini

# Autopilot runtime state (the script itself is tracked; its output is not)
tools/autopilot/autopilot.log
tools/autopilot/last-run.txt
tools/autopilot/RUNNING.lock
tools/autopilot/retry-after.txt
tools/autopilot/STOP
tools/autopilot/pause-until.txt

# Session-local agent state
.claude/scheduled_tasks.lock

# Scratch from research sessions. Saved web pages and scraper helpers are not
# project files, and publishing copies of somebody else's pages in a repo that
# may be shared is an attribution problem nobody asked for.
*.html
